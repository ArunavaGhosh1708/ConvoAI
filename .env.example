# Database
POSTGRES_USER=convoai
POSTGRES_PASSWORD=convoai
POSTGRES_DB=convoai
DATABASE_URL=postgresql+asyncpg://convoai:convoai@localhost:5432/convoai

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# App
APP_ENV=development
LOG_LEVEL=INFO

# RAG
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
MMR_LAMBDA=0.5
ESCALATION_CONFIDENCE_THRESHOLD=0.65

# LangChain Agent
LLM_MODEL=gpt-4-turbo
LLM_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=5

# Memory
MEMORY_WINDOW=10

# Auth (replace these with strong random values in production)
API_KEY=dev-api-key
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256

# Rate limiting
RATE_LIMIT_RPM=100

# CORS (comma-separated origins; use * for development only)
CORS_ORIGINS=*

# Voice — Whisper STT
# OQ-03: "openai" = OpenAI hosted API (default); "sidecar" = self-hosted faster-whisper
WHISPER_BACKEND=openai
WHISPER_SIDECAR_URL=http://whisper-stt:9000
WHISPER_MODEL_SIZE=large-v3

# Voice — ElevenLabs TTS (leave empty to disable TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_SPEED=1.0

# Celery (uses Redis db/1 to avoid collision with session cache on db/0)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# PagerDuty (set integration key to enable alerting)
PAGERDUTY_INTEGRATION_KEY=
